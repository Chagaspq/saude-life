      "name": "1. Conta",
      "item": [
        {
          "name": "Login cliente demo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Entra com o cliente de demonstração e guarda o token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@saudelife.app\",\n  \"senha\": \"demo1234\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda o token para as próximas chamadas",
                  "if (pm.response.code < 300) pm.collectionVariables.set('{salvar}', pm.response.json().token);"
                ]
              }
            }
          ]
        },
