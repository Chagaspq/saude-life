<?xml version="1.0" encoding="UTF-8"?>
<!-- Projeto Maven do servidor (API) do Saúde Life. Abra no Spring Tools: File > Import > Existing Maven Projects -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!-- Versão do formato do arquivo -->
  <modelVersion>4.0.0</modelVersion>

  <!-- Herda as configurações do Spring Boot -->
  <parent>
    <!-- Grupo do Spring Boot -->
    <groupId>org.springframework.boot</groupId>
    <!-- Projeto pai -->
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Versão do Spring Boot -->
    <version>3.3.5</version>
    <!-- Busca no repositório do Maven -->
    <relativePath/>
  </parent>

  <!-- Nome do pacote do projeto -->
  <groupId>br.com.saudelife</groupId>
  <!-- Nome do projeto -->
  <artifactId>saude-life-api</artifactId>
  <!-- Versão do projeto -->
  <version>1.0.0</version>
  <!-- Nome que aparece no Spring Tools -->
  <name>saude-life-api</name>
  <!-- Descrição -->
  <description>API REST do Saúde Life (TCC)</description>

  <!-- Configurações -->
  <properties>
    <!-- Java 17 ou mais novo -->
    <java.version>17</java.version>
  </properties>

  <!-- Bibliotecas usadas -->
  <dependencies>
    <!-- Rotas REST (controladores, JSON) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Banco de dados com JPA (tabelas viram classes Java) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Validação dos dados que chegam (@NotBlank, @Email...) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Envio de e-mail (esqueci a senha) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- Só a parte de senha do Spring Security (BCrypt) -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <!-- Banco H2 na memória (roda sem instalar nada) -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Driver do PostgreSQL (banco de verdade) -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Reinicia sozinho ao salvar no Spring Tools -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <!-- Testes automáticos -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Como gerar o programa -->
  <build>
    <plugins>
      <!-- Gera o .jar que roda sozinho -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
