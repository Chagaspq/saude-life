erDiagram
    ACADEMIAS ||--o{ USUARIOS : "tem clientes e admin"
    ACADEMIAS ||--o{ AVISOS : "recebe"
    USUARIOS ||--o{ AVISOS : "publica (admin)"
    USUARIOS ||--o{ TREINOS : "dono da ficha"
    USUARIOS |o--o{ TREINOS : "autor (admin que mandou)"
    TREINOS ||--|{ TREINO_ITENS : "tem exercicios"
    USUARIOS ||--o{ SESSOES_TREINO : "treinos feitos"
    USUARIOS ||--o{ REFEICOES : "registra"
    USUARIOS ||--o{ AGUA_DIA : "bebe"
    USUARIOS ||--o{ PESOS : "registra"
    USUARIOS ||--o{ PONTOS : "ganha"
    USUARIOS ||--o{ SESSOES_LOGIN : "logins abertos"
    USUARIOS ||--o{ REDEFINICOES_SENHA : "pede nova senha"

    ACADEMIAS {
        uniqueidentifier id PK
        nvarchar nome
        nvarchar codigo UK
        datetimeoffset criada_em
    }
    USUARIOS {
        uniqueidentifier id PK
        nvarchar nome
        nvarchar email UK
        nvarchar senha_hash
        nvarchar tipo "cliente ou admin"
        uniqueidentifier academia_id FK
        nvarchar objetivo
        int dias_semana
        nvarchar plano
    }
    TREINOS {
        uniqueidentifier id PK
        uniqueidentifier usuario_id FK
        uniqueidentifier autor_id FK
        nvarchar nome
        nvarchar grupo
    }
    TREINO_ITENS {
        bigint id PK
        uniqueidentifier treino_id FK
        int ordem
        nvarchar nome
        int series
        nvarchar reps
        float carga
        int descansos
    }
    SESSOES_TREINO {
        uniqueidentifier id PK
        uniqueidentifier usuario_id FK
        nvarchar nome
        datetimeoffset data
        int duracao_min
        int series
        float volume
        int kcal
    }
    REFEICOES {
        uniqueidentifier id PK
        uniqueidentifier usuario_id FK
        date dia
        nvarchar nome
        int kcal
        int proteina
        int carbo
        int gordura
    }
    AGUA_DIA {
        bigint id PK
        uniqueidentifier usuario_id FK
        date dia
        int ml
    }
    PESOS {
        bigint id PK
        uniqueidentifier usuario_id FK
        datetimeoffset data
        float valor_kg
    }
    PONTOS {
        bigint id PK
        uniqueidentifier usuario_id FK
        nvarchar ref
        nvarchar tipo
        int pts
    }
    AVISOS {
        uniqueidentifier id PK
        uniqueidentifier academia_id FK
        uniqueidentifier autor_id FK
        nvarchar texto
        datetimeoffset data
    }
    SESSOES_LOGIN {
        nvarchar token_hash PK
        uniqueidentifier usuario_id FK
        datetimeoffset expira_em
    }
    REDEFINICOES_SENHA {
        nvarchar token_hash PK
        uniqueidentifier usuario_id FK
        datetimeoffset expira_em
        bit usado
    }
